APP_ENV=dev
CORS_ENABLED=false
CORS_ALLOWED_ORIGINS=
CORS_ALLOWED_METHODS=GET,HEAD
CORS_ALLOWED_HEADERS=
CORS_EXPOSED_HEADERS=
CORS_ALLOW_CREDENTIALS=false
CORS_MAX_AGE=10m
RATE_LIMIT_ENABLED=false
RATE_LIMIT_REQUESTS_PER_SECOND=10
RATE_LIMIT_BURST=20
RATE_LIMIT_MAX_CLIENTS=10000
RATE_LIMIT_ENTRY_TTL=10m
DB_ENABLED=false
DB_PROVIDER=postgres
DATABASE_URL=
DB_MAX_OPEN_CONNS=10
DB_MAX_IDLE_CONNS=2
DB_CONN_MAX_LIFETIME=30m
DB_CONN_MAX_IDLE_TIME=5m
DB_CONNECT_TIMEOUT=5s
DB_PING_TIMEOUT=2s
POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_DB=
POSTGRES_PORT=5432
LOG_LEVEL=
IMAGE_TAG=local
HTTP_PORT=8080
HTTP_READ_HEADER_TIMEOUT=
HTTP_READ_TIMEOUT=
HTTP_WRITE_TIMEOUT=
HTTP_IDLE_TIMEOUT=
HTTP_SHUTDOWN_TIMEOUT=
HTTP_CLIENT_TIMEOUT=
HTTP_CLIENT_CONNECT_TIMEOUT=
HTTP_CLIENT_TLS_HANDSHAKE_TIMEOUT=
HTTP_CLIENT_RESPONSE_HEADER_TIMEOUT=
HTTP_CLIENT_IDLE_CONN_TIMEOUT=
HTTP_CLIENT_MAX_IDLE_CONNS=
HTTP_CLIENT_MAX_IDLE_CONNS_PER_HOST=
HTTP_CLIENT_MAX_CONNS_PER_HOST=
STOP_GRACE_PERIOD=30s
